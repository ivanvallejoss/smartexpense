# -----------------------------------------------------------------------------
# Django Core
# -----------------------------------------------------------------------------

# Set to False in production
DEBUG=True

# Random secret string used by Django for cryptographic signing (cookies, sessions).
# Generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Separate secret used to sign JWT tokens for the Magic Link authentication flow.
# Can be generated the same way as SECRET_KEY — keep them different.
JWT_SECRET_KEY=your-jwt-secret-key-here

# Where this process runs: "dev" or "prod". Drives infrastructure defaults.
# Kept separate from DEBUG on purpose — DEBUG is a Django behaviour flag.
ENVIRONMENT=dev

# Comma-separated list of allowed hostnames, e.g. smartexpense.ar,www.smartexpense.ar
# Only dev + DEBUG defaults to "*". In prod this MUST be set or Django rejects
# every request — that is intentional.
ALLOWED_HOSTS=*


# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------

# Local development (docker compose up db):
DATABASE_URL=postgresql://user_dev:password_dev@localhost:5442/smartexpense_db

# If running the full Docker stack (web/worker containers):
# DATABASE_URL=postgresql://user_dev:password_dev@db:5432/smartexpense_db
#
# TLS: sslmode travels in the URL, not in settings.py. Use it only when the
# database is remote and actually serves TLS (e.g. a managed provider):
# DATABASE_URL=postgresql://user:pass@remote-host:5432/db?sslmode=require
# On a VPS where Postgres listens on localhost, omit it — libpq defaults to
# "prefer" and requiring TLS against a server without certificates fails.
#
# If DATABASE_URL is unset, the project falls back to sqlite:///db.sqlite3,
# which is enough to run migrations and the test suite without Postgres.


# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------

# Points to database 0 — ARQ uses this as the job queue.
# The system internally routes to db 1 (conversation state) and db 2 (cache).
# Local development (docker compose up redis):
REDIS_URL=redis://localhost:6389/0

# If running the full Docker stack:
# REDIS_URL=redis://redis:6379/0


# -----------------------------------------------------------------------------
# Telegram Bot
# -----------------------------------------------------------------------------

# Bot token from @BotFather. Required for both the webhook and the ARQ worker.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Secret string used to validate that webhook requests come from Telegram.
# Set this to any random string and configure it when registering the webhook:
# python manage.py set_webhook https://your-domain.com
TELEGRAM_WEBHOOK_TOKEN=your-webhook-secret-here


# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------

# URL of the React dashboard — used to build Magic Link URLs and configure CORS.
FRONTEND_URL=http://127.0.0.1:5173
